# Copy to .env.local and fill in. The site runs without any of these — auth,
# payments and booking degrade to clearly-labelled demo modes until they are set.

# ---- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Bypasses RLS. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Razorpay (INR) ---------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Server only. Signs and verifies checkout signatures.
RAZORPAY_KEY_SECRET=your-key-secret
# Server only, and DIFFERENT from the key secret. Set it in the Razorpay
# dashboard when you create the webhook.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Same value as RAZORPAY_KEY_ID. Duplicated deliberately: the server never reads
# the public one, so a mismatch fails loudly instead of quietly charging the
# wrong account.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ---- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPPORT_EMAIL=coach@mackfitcoach.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=+919999999999
